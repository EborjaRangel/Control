{
  "name": "control-back",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate",
    "build:check": "npm run typecheck",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
    "start": "tsx src/index.ts",
    "start:prod": "prisma migrate deploy && tsx src/index.ts",
    "db:migrate": "prisma migrate deploy",
    "geo:import-secciones": "tsx scripts/import-secciones-ine.ts",
    "geo:import-colonias": "tsx scripts/import-colonias-sepomex.ts",
    "geo:import-uts": "tsx scripts/import-unidades-territoriales-iecm.ts",
    "geo:sync-colonia-uts": "tsx scripts/sync-colonia-ut-enlaces.ts",
    "geo:ensure-iecm-uts": "tsx scripts/ensure-iecm-uts-json.ts",
    "geo:generate-colonia-ut-claves": "tsx scripts/generate-colonia-ut-claves.ts",
    "geo:verify-claves-secciones": "tsx scripts/verify-claves-todas-secciones.ts",
    "geo:verify-ut-unica-secciones": "tsx scripts/verify-ut-unica-secciones.ts",
    "geo:verify-colonias-secciones": "tsx scripts/verify-colonias-secciones.ts",
    "geo:verify-peso-colonias": "tsx scripts/verify-peso-geo-colonias.ts",
    "electoral:import-casillas": "tsx scripts/import-casillas-ine.ts",
    "electoral:import-resultados-alcaldia": "tsx scripts/import-resultados-alcaldia-iecm.ts",
    "db:seed": "tsx scripts/seed-admin.ts",
    "db:reset-admin": "tsx scripts/reset-admin.ts",
    "db:prepare-dirigentes-carga": "tsx scripts/prepare-dirigentes-carga-sheet.ts",
    "db:import-dirigentes": "tsx scripts/import-dirigentes-excel.ts",
    "db:update-dirigentes-colonia-ut": "tsx scripts/update-dirigentes-colonia-ut.ts",
    "db:update-dirigentes-distrito-federal": "tsx scripts/update-dirigentes-distrito-federal.ts",
    "db:import-nomina-matriz": "tsx scripts/import-nomina-matriz-pagos.ts",
    "db:provision-usuarios": "tsx scripts/provision-usuarios-dirigentes.ts",
    "db:sync-to-production": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/sync-local-to-production.ps1",
    "db:sync-from-production": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/sync-production-to-local.ps1",
    "env:sync-from-railway": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/sync-env-from-railway.ps1",
    "env:sync-to-railway": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/sync-env-to-railway.ps1",
    "email:test-smtp": "tsx scripts/test-smtp.ts",
    "twilio:test": "tsx scripts/test-twilio-whatsapp.ts",
    "whatsapp:test": "tsx scripts/test-whatsapp.ts",
    "whatsapp:verify": "tsx scripts/test-whatsapp-cloud.ts",
    "uploads:sync-to-production": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/sync-uploads-to-production.ps1",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@turf/area": "^7.3.5",
    "@turf/bbox": "^7.3.5",
    "@turf/boolean-point-in-polygon": "^7.3.5",
    "@turf/circle": "^7.3.5",
    "@turf/helpers": "^7.3.5",
    "adm-zip": "^0.5.17",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.0.2",
    "nodemailer": "^9.0.0",
    "pg": "^8.21.0",
    "prisma": "^7.8.0",
    "proj4": "^2.20.9",
    "shapefile": "^0.6.6",
    "tsx": "^4.22.4",
    "twilio": "^6.0.2",
    "xlsx": "^0.18.5",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "typescript": "^5"
  }
}
