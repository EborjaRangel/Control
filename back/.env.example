# PostgreSQL
DATABASE_URL="postgresql://postgres:password@localhost:5432/control"

# Puerto del API
PORT=4000

# Origen permitido del frontend (CORS). Varios orígenes separados por coma.
# Producción: https://tu-proyecto.vercel.app
FRONTEND_URL="http://localhost:3000"

# URL pública de la app (enlaces en QR de asistencia y convocatorias)
PUBLIC_APP_URL="http://localhost:3000"

# Autenticación JWT (cambiar en producción)
JWT_SECRET="genera-un-secreto-largo-y-aleatorio"

# Usuario administrador inicial (npm run db:seed)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin123"

# --- Convocatoria: envíos reales (correo, SMS y WhatsApp) ---
# Obligatorias para enviar convocatorias. Sin simulación.

# Correo — opción A: Resend (recomendado en Railway Hobby; SMTP bloqueado ahí)
# Crea cuenta en https://resend.com → API Keys
RESEND_API_KEY="re_xxxxxxxx"
RESEND_FROM="Control Coyoacán <onboarding@resend.dev>"

# Correo — opción B: Gmail SMTP (funciona en local y Railway Pro)
# Gmail: activa verificación en 2 pasos y crea una contraseña de aplicación en
# https://myaccount.google.com/apppasswords
# SMTP_USER = correo completo (ej. nombre@gmail.com)
# SMTP_PASS = contraseña de aplicación de 16 caracteres (sin espacios)
# SMTP_FROM debe usar el mismo correo que SMTP_USER
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="tu-correo@gmail.com"
SMTP_PASS="abcdefghijklmnop"
SMTP_FROM="Control Coyoacán <tu-correo@gmail.com>"

# Opcional en local: muestra el enlace de recuperación en pantalla si SMTP no está configurado
# SMTP_DEV_LOG="true"

# Twilio — SMS y WhatsApp
TWILIO_ACCOUNT_SID="ACxxxxxxxx"
TWILIO_AUTH_TOKEN="tu-auth-token"
TWILIO_SMS_FROM="+521234567890"
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"
