# Copia a back/.env y completa los valores reales.

DATABASE_URL="postgresql://postgres:password@localhost:5432/control"
PORT=4000
JWT_SECRET="cambia-esto"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin123"
FRONTEND_URL="http://localhost:3000"
PUBLIC_APP_URL="http://localhost:3000"

# Correo (recuperación de contraseña + convocatoria)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="tu-correo@gmail.com"
SMTP_PASS="contraseña-de-aplicacion-16-chars"
SMTP_FROM="Control Coyoacán <tu-correo@gmail.com>"

# Twilio — SMS (opcional) y WhatsApp legacy
# Consola: https://console.twilio.com
# TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# TWILIO_AUTH_TOKEN="tu-auth-token"
# TWILIO_SMS_FROM="+1XXXXXXXXXX"
# TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"

# WhatsApp — Meta Cloud API (recomendado, directo)
# developers.facebook.com → App → WhatsApp → API Setup
WHATSAPP_PROVIDER="meta"
WHATSAPP_CLOUD_ACCESS_TOKEN="tu-token-permanente"
WHATSAPP_CLOUD_PHONE_NUMBER_ID="123456789012345"
# WHATSAPP_CLOUD_API_VERSION="v22.0"
# Plantilla para convocatorias (obligatoria fuera de ventana 24 h):
# WHATSAPP_CLOUD_TEMPLATE_NAME="convocatoria_evento"
# WHATSAPP_CLOUD_TEMPLATE_LANGUAGE="es_MX"
# WHATSAPP_CLOUD_TEMPLATE_VARIABLES='{"1":"texto de la convocatoria"}'
# WHATSAPP_CLOUD_SOLO_PLANTILLA="true"

# Solo local: muestra enlace de recuperación sin enviar correo
# SMTP_DEV_LOG="true"
