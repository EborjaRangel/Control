# Copia a back/.env y completa los valores reales.

DATABASE_URL="postgresql://postgres:password@localhost:5432/control"
PORT=4000
JWT_SECRET="cambia-esto"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin123"
FRONTEND_URL="http://localhost:3000"
PUBLIC_APP_URL="http://localhost:3000"

# Correo (recuperación de contraseña + convocatoria)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="tu-correo@gmail.com"
SMTP_PASS="contraseña-de-aplicacion-16-chars"
SMTP_FROM="Control Coyoacán <tu-correo@gmail.com>"

# Twilio — WhatsApp (prioritario) y SMS
# Consola: https://console.twilio.com
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="tu-auth-token"
# Sandbox WhatsApp (pruebas): whatsapp:+14155238886
# Producción: whatsapp:+52XXXXXXXXXX (número aprobado en Twilio)
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"
# SMS México (opcional): +1XXXXXXXXXX
TWILIO_SMS_FROM="+1XXXXXXXXXX"

# Plantilla WhatsApp de producción (opcional; si no, usa Body en sandbox)
# TWILIO_WHATSAPP_CONTENT_SID="HXxxxxxxxx"
# TWILIO_WHATSAPP_CONTENT_VARIABLES='{"1":"texto de la convocatoria"}'

# Solo local: muestra enlace de recuperación sin enviar correo
# SMTP_DEV_LOG="true"
